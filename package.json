{
  "name": "insteltech-site",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o tailwind.generated.css --minify",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:edge": "node tests/crm-edge.integration.mjs && node tests/crm-scheduler-edge.integration.mjs",
    "test:db": "node scripts/test-crm-db.mjs",
    "check:backend": "deno check --config supabase/functions/deno.json --no-lock supabase/functions/crm-action/index.ts supabase/functions/crm-automation/index.ts supabase/functions/mail-send/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "deno": "^2.9.6",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.17"
  }
}
